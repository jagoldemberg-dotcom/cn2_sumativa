        {
          "name": "07 - Eliminar usuario por BFF",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{bffBase}}/api/users/{{bffUserId}}"
          }
        }
      ]
    },
    {
      "name": "04 - BFF AWS - ROLES REST hacia GraphQL",
      "item": [
        {
          "name": "01 - Listar roles por BFF (REST -> GraphQL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffBase}}/api/roles",
            "description": "Petición REST al BFF. Internamente RolesGraphqlService construye una query GraphQL y llama a roles-function."
          }
        },
        {
          "name": "02 - Consultar rol por BFF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffBase}}/api/roles/{{seedRoleId}}"
          }
        },
        {
          "name": "03 - Crear rol por BFF (guarda bffRoleId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffBase}}/api/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BFF_ROLE_{{$timestamp}}\",\n  \"description\": \"Cliente REST al BFF, traducido internamente a mutation GraphQL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.id) pm.collectionVariables.set('bffRoleId', String(j.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Actualizar rol por BFF",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffBase}}/api/roles/{{bffRoleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BFF_ROLE_UPDATED_{{$timestamp}}\",\n  \"description\": \"Actualizado por REST en BFF y GraphQL hacia Azure\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 - Eliminar rol por BFF",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{bffBase}}/api/roles/{{bffRoleId}}",
            "description": "Limpieza del rol temporal creado por BFF."
          }
        }
      ]
    }
  ]
}